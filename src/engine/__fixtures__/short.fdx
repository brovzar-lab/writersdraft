<?xml version="1.0" encoding="UTF-8" standalone="no" ?>
<FinalDraft DocumentType="Script" Template="No" Version="5">
  <Content>
    <Paragraph Type="Scene Heading">
      <SceneProperties Length="2/8" Page="1" Title=""/>
      <Text>INT. DINER - NIGHT</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Rain streaks the window. MABEL, 60s, wipes the counter with a rag that has seen better decades. The neon sign buzzes: EAT &amp; RUN.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>MABEL</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(without looking up)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>We close at ten.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>The door chimes. A STRANGER in a soaked coat stands in the frame.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>STRANGER</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Then I have four minutes.</Text>
    </Paragraph>
    <Paragraph Type="Transition">
      <Text>CUT TO:</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading">
      <SceneProperties Length="1/8" Page="1" Title=""/>
      <Text>EXT. DINER - CONTINUOUS</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>A sedan idles across the street, lights off.</Text>
    </Paragraph>
  </Content>
  <TitlePage>
    <Content>
      <Paragraph Alignment="Center">
        <Text>FOUR MINUTES</Text>
      </Paragraph>
      <Paragraph Alignment="Center">
        <Text></Text>
      </Paragraph>
      <Paragraph Alignment="Center">
        <Text>written by</Text>
      </Paragraph>
      <Paragraph Alignment="Center">
        <Text>Billy Rovzar</Text>
      </Paragraph>
      <Paragraph Alignment="Center">
        <Text></Text>
      </Paragraph>
      <Paragraph Alignment="Center">
        <Text>First Draft - July 2026</Text>
      </Paragraph>
      <Paragraph Alignment="Left">
        <Text>billy@example.com</Text>
      </Paragraph>
    </Content>
  </TitlePage>
  <ElementSettings Type="Scene Heading">
    <FontSpec AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" Size="12" Style="AllCaps"/>
    <ParagraphSpec Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.50" RightIndent="7.50" SpaceBefore="24" Spacing="1" StartsNewPage="No"/>
  </ElementSettings>
  <SmartType>
    <Characters>
      <Character>MABEL</Character>
      <Character>STRANGER</Character>
    </Characters>
    <Extensions>
      <Extension>(V.O.)</Extension>
      <Extension>(O.S.)</Extension>
    </Extensions>
  </SmartType>
